{
	"$schema": "https://json.schemastore.org/eas.json",
	"cli": {
		"appVersionSource": "remote",
		"version": ">= 21.0.2"
	},
	"build": {
		"development": {
			"developmentClient": true,
			"distribution": "internal",
			"channel": "development",
			"environment": "development",
			"node": "24.18.0",
			"pnpm": "11.12.0",
			"android": {
				"buildType": "apk"
			}
		},
		"preview": {
			"distribution": "internal",
			"channel": "preview",
			"environment": "preview",
			"node": "24.18.0",
			"pnpm": "11.12.0",
			"android": {
				"buildType": "apk"
			}
		},
		"production": {
			"autoIncrement": true,
			"channel": "production",
			"environment": "production",
			"node": "24.18.0",
			"pnpm": "11.12.0"
		}
	},
	"submit": {
		"production": {
			"android": {
				"track": "internal",
				"releaseStatus": "draft"
			}
		}
	}
}
