{
	"name": "@minha-associacao/mobile",
	"main": "expo-router/entry",
	"version": "1.0.0",
	"dependencies": {
		"@minha-associacao/design-tokens": "workspace:*",
		"@react-native-vector-icons/material-design-icons": "catalog:react-native",
		"expo": "~57.0.12",
		"expo-constants": "~57.0.10",
		"expo-dev-client": "~57.0.11",
		"expo-font": "catalog:expo",
		"expo-image": "catalog:expo",
		"expo-linking": "catalog:expo",
		"expo-router": "~57.0.12",
		"expo-splash-screen": "~57.0.6",
		"expo-system-ui": "catalog:expo",
		"expo-updates": "~57.0.13",
		"expo-web-browser": "catalog:expo",
		"react": "catalog:react",
		"react-native": "catalog:react-native",
		"react-native-gesture-handler": "catalog:react-native",
		"react-native-paper": "catalog:react-native",
		"react-native-reanimated": "catalog:react-native",
		"react-native-safe-area-context": "catalog:react-native",
		"react-native-screens": "catalog:react-native",
		"react-native-worklets": "catalog:react-native"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@faker-js/faker": "catalog:",
		"@minha-associacao/ts-config": "workspace:*",
		"@types/react": "catalog:react",
		"@vitest/coverage-v8": "catalog:",
		"expo-doctor": "catalog:expo",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"scripts": {
		"dev": "expo start",
		"start": "expo start",
		"export": "expo export --platform android --output-dir dist/android && expo export --platform ios --output-dir dist/ios",
		"expo:check": "expo-doctor && expo install --check && expo config --type public --json",
		"eas:development": "pnpx eas-cli@21.0.2 workflow:run create-development-builds.yml",
		"eas:preview": "pnpx eas-cli@21.0.2 workflow:run deliver-preview.yml",
		"eas:production": "pnpx eas-cli@21.0.2 workflow:run release-production.yml",
		"eas:submit": "pnpx eas-cli@21.0.2 workflow:run submit-production.yml",
		"eas:rollback": "pnpx eas-cli@21.0.2 workflow:run rollback-production-update.yml",
		"reset-project": "node ./scripts/reset-project.js",
		"android": "expo start --android",
		"ios": "expo start --ios",
		"typecheck": "tsc --noEmit --incremental false",
		"lint": "biome lint .",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage"
	},
	"private": true
}
