{
	"name": "@minha-associacao/api",
	"private": true,
	"type": "module",
	"main": "./dist/index.js",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc --project tsconfig.json",
		"dev": "tsx watch --conditions=development src/dev.ts",
		"lint": "biome lint src test vitest.config.ts",
		"start": "node --enable-source-maps dist/index.js",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"typecheck": "tsc --project tsconfig.json --noEmit --incremental false && tsc --project tsconfig.test.json --noEmit --incremental false",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:check": "drizzle-kit check",
		"db:studio": "drizzle-kit studio",
		"db:ping": "tsx src/db/ping.ts"
	},
	"dependencies": {
		"@fastify/autoload": "catalog:api",
		"@fastify/cors": "catalog:api",
		"@fastify/helmet": "catalog:api",
		"@fastify/rate-limit": "catalog:api",
		"@minha-associacao/config": "workspace:*",
		"dotenv": "catalog:api",
		"drizzle-orm": "0.45.2",
		"fastify": "catalog:api",
		"fastify-type-provider-zod": "catalog:api",
		"pg": "8.22.0",
		"typeid-js": "1.2.0",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@minha-associacao/ts-config": "workspace:*",
		"@types/node": "catalog:",
		"@types/pg": "8.20.0",
		"@vitest/coverage-v8": "catalog:",
		"drizzle-kit": "0.31.10",
		"pino-pretty": "catalog:api",
		"tsx": "catalog:api",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
