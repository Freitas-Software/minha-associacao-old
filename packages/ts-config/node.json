{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": "./base.json",
	"compilerOptions": {
		"inlineSources": true,
		"lib": ["ES2024"],
		"module": "NodeNext",
		"moduleDetection": "force",
		"moduleResolution": "NodeNext",
		"sourceMap": true,
		"target": "ES2024",
		"types": ["node"]
	}
}
