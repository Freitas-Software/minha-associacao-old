{
	"extends": "@minha-associacao/ts-config/react-library",
	"compilerOptions": {
		"noEmit": false,
		"declaration": true,
		"declarationMap": true,
		"incremental": true,
		"outDir": "dist",
		"rootDir": "src",
		"tsBuildInfoFile": "./.turbo/tsconfig.build.tsbuildinfo"
	},
	"include": ["src/**/*.ts", "src/**/*.tsx"],
	"exclude": ["node_modules", "dist"]
}
