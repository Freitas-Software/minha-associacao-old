{
	"name": "@minha-associacao/ui-web",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"development": "./src/index.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc --project tsconfig.json",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"typecheck": "tsc --project tsconfig.json --noEmit --incremental false"
	},
	"dependencies": {
		"@emotion/react": "11.14.0",
		"@emotion/styled": "11.14.1",
		"@minha-associacao/ui-core": "workspace:*",
		"@mui/material": "9.2.0"
	},
	"peerDependencies": {
		"react": ">=19.0.0",
		"react-dom": ">=19.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@minha-associacao/ts-config": "workspace:*",
		"@types/node": "catalog:",
		"@types/react": "catalog:react",
		"@types/react-dom": "catalog:react",
		"react": "catalog:react",
		"react-dom": "catalog:react",
		"typescript": "catalog:"
	}
}
