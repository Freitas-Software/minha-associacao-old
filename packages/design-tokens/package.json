{
	"name": "@minha-associacao/design-tokens",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"sideEffects": false,
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"react-native": "./src/index.ts",
	"files": [
		"src"
	],
	"exports": {
		".": {
			"types": "./src/index.ts",
			"react-native": "./src/index.ts",
			"development": "./src/index.ts",
			"import": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"scripts": {
		"build": "tsc --incremental false",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage"
	},
	"devDependencies": {
		"@minha-associacao/ts-config": "workspace:*",
		"@vitest/coverage-v8": "catalog:",
		"typescript": "catalog:",
		"@types/node": "catalog:",
		"vitest": "catalog:"
	}
}
