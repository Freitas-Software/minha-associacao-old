{
	"extends": "@minha-associacao/ts-config/react-native-library",
	"compilerOptions": {
		"declaration": true,
		"declarationMap": true,
		"incremental": true,
		"noEmit": false,
		"outDir": "dist",
		"rootDir": "src",
		"tsBuildInfoFile": "./.turbo/tsconfig.build.tsbuildinfo"
	},
	"include": ["src/**/*.ts"],
	"exclude": ["dist", "node_modules"]
}
