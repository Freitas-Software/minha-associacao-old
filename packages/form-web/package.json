{
	"name": "@minha-associacao/form-web",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"sideEffects": false,
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"files": [
		"src"
	],
	"exports": {
		".": {
			"types": "./src/index.ts",
			"development": "./src/index.ts",
			"import": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"scripts": {
		"build": "tsc --project tsconfig.json",
		"dev": "tsc --project tsconfig.json --watch --preserveWatchOutput",
		"lint": "biome lint src test vitest.config.ts",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"typecheck": "tsc --project tsconfig.json --noEmit --incremental false && tsc --project tsconfig.test.json --noEmit --incremental false"
	},
	"dependencies": {
		"@minha-associacao/form-core": "workspace:*",
		"@minha-associacao/ui-web": "workspace:*",
		"@tanstack/react-form": "catalog:"
	},
	"peerDependencies": {
		"react": ">=19.0.0",
		"react-dom": ">=19.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@emotion/react": "catalog:web",
		"@emotion/styled": "catalog:web",
		"@mui/material": "catalog:web",
		"@minha-associacao/theme-web": "workspace:*",
		"@minha-associacao/ts-config": "workspace:*",
		"@testing-library/dom": "catalog:",
		"@testing-library/react": "catalog:",
		"@testing-library/user-event": "catalog:",
		"@types/node": "catalog:",
		"@types/react": "catalog:react",
		"@types/react-dom": "catalog:react",
		"@vitest/coverage-v8": "catalog:",
		"jsdom": "catalog:",
		"react": "catalog:react",
		"react-dom": "catalog:react",
		"typescript": "catalog:",
		"vitest": "catalog:",
		"zod": "catalog:"
	}
}
