{
	"name": "minha-associacao",
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"dev:api": "turbo run dev --filter=@minha-associacao/api",
		"dev:mobile": "pnpm dev:api && turbo run dev --filter=@minha-associacao/mobile",
		"dev:web": "pnpm dev:api && turbo run dev --filter=@minha-associacao/web",
		"lint": "turbo run lint lint:root",
		"lint:root": "biome lint package.json turbo.json biome.json",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"typecheck": "turbo run typecheck",
		"test": "turbo run test",
		"test:coverage": "turbo run test:coverage",
		"expo:check": "turbo run expo:check",
		"export": "turbo run export",
		"check:generated": "turbo run check:generated",
		"boundaries": "turbo boundaries",
		"check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm expo:check && pnpm check:generated && pnpm boundaries",
		"verify": "pnpm check && pnpm build"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"turbo": "2.10.6"
	},
	"packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72",
	"engines": {
		"node": "24.18.0",
		"pnpm": "11.17.0"
	}
}
